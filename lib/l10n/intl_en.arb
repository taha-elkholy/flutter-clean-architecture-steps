{
    "@@locale": "en",

    "appTitle": "Recipes",
    "@appTitle": {
        "description": "Application title, also shown in the recipe list app bar"
    },

    "topRated": "Top Rated",
    "@topRated": {
        "description": "Recipe list sort chip: highest rated recipes first"
    },
    "mostReviewed": "Most Reviewed",
    "@mostReviewed": {
        "description": "Recipe list sort chip: most reviewed recipes first"
    },

    "recipeMeta": "{cuisine} · {difficulty}",
    "@recipeMeta": {
        "description": "Meta line under a recipe card: cuisine and difficulty",
        "placeholders": {
            "cuisine": {
                "type": "String"
            },
            "difficulty": {
                "type": "String"
            }
        }
    },

    "recipeNamePlaceholder": "Recipe name placeholder",
    "@recipeNamePlaceholder": {
        "description": "Fake recipe name shown inside the skeleton loading cards"
    },
    "cuisinePlaceholder": "Cuisine",
    "@cuisinePlaceholder": {
        "description": "Fake cuisine shown inside the skeleton loading cards"
    },
    "difficultyPlaceholder": "Easy",
    "@difficultyPlaceholder": {
        "description": "Fake difficulty shown inside the skeleton loading cards"
    },

    "noRecipes": "No recipes to show",
    "@noRecipes": {
        "description": "Message shown on the recipe list when a sort comes back with no recipes"
    },

    "searchHint": "Search recipes...",
    "@searchHint": {
        "description": "Hint text of the search field in the search page app bar"
    },
    "searchEmptyState": "Type a recipe name and hit enter",
    "@searchEmptyState": {
        "description": "Message shown on the search page before any search is made"
    },
    "searchNoResults": "No recipes matched your search",
    "@searchNoResults": {
        "description": "Message shown on the search page when a search returns nothing"
    },

    "recipeMetaWithCalories": "{cuisine} · {difficulty} · {calories} cal",
    "@recipeMetaWithCalories": {
        "description": "Meta line on the details page: cuisine, difficulty and calories per serving",
        "placeholders": {
            "cuisine": {
                "type": "String"
            },
            "difficulty": {
                "type": "String"
            },
            "calories": {
                "type": "int"
            }
        }
    },
    "ingredients": "Ingredients",
    "@ingredients": {
        "description": "Section title above the ingredients list on the details page"
    },
    "instructions": "Instructions",
    "@instructions": {
        "description": "Section title above the instructions list on the details page"
    },

    "somethingWentWrong": "Something went wrong",
    "@somethingWentWrong": {
        "description": "Fallback error message, used for any error code with no message of its own"
    },
    "noInternetConnectionError": "No internet connection. Check your network and try again",
    "@noInternetConnectionError": {
        "description": "Error message shown when the device has no network connection"
    },
    "timeoutError": "The request took too long. Please try again",
    "@timeoutError": {
        "description": "Error message shown when a request times out"
    },
    "notFoundError": "We could not find what you were looking for",
    "@notFoundError": {
        "description": "Error message for HTTP 404"
    },
    "serverError": "The server ran into a problem. Please try again later",
    "@serverError": {
        "description": "Error message for a failing response from the server"
    },
    "parsingError": "We could not read the response from the server",
    "@parsingError": {
        "description": "Error message shown when the response body is not in the shape the app expects"
    },
    "retry": "Retry",
    "@retry": {
        "description": "Button that runs the failed request again"
    },

    "routeNotFoundTitle": "Page not found",
    "@routeNotFoundTitle": {
        "description": "App bar title of the fallback screen shown for an unknown route"
    },
    "routeNotFoundMessage": "No screen is registered for \"{routeName}\".",
    "@routeNotFoundMessage": {
        "description": "Body of the fallback screen, naming the route that could not be resolved",
        "placeholders": {
            "routeName": {
                "type": "String"
            }
        }
    }
}
